---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations } from '../../i18n/utils';
import CABRAppInicio from '../../assets/cabra2.jpeg';
import esconditeWebInicio from '../../assets/escritorio_inicio.jpeg';
import Skills from '../../components/Skills.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const strongestSkills = [
  { icon: 'simple-icons:mysql', name: 'SQL' },
  { icon: 'simple-icons:microsoftsqlserver', name: 'SQL Server' },
  { icon: 'simple-icons:python', name: 'Python' },
  { icon: 'simple-icons:git', name: 'Git' },
  { icon: 'simple-icons:github', name: 'GitHub' },
];

const workingSkills = [
  { icon: 'simple-icons:django', name: 'Django' },
  { icon: 'simple-icons:azure', name: 'Azure Blob' },
  { icon: 'simple-icons:javascript', name: 'JavaScript' },
  { icon: 'simple-icons:mysql', name: 'MySQL' },
  { icon: 'simple-icons:powerbi', name: 'Power BI' },
  { icon: 'simple-icons:astro', name: 'Astro' },
  { icon: 'simple-icons:docker', name: 'Docker' },
  { icon: 'simple-icons:swagger', name: 'APIs' },
];

const foundationalSkills = [
  { icon: 'simple-icons:react', name: 'React' },
  { icon: 'simple-icons:nextdotjs', name: 'Next.js' },
  { icon: 'simple-icons:flutter', name: 'Flutter' },
  { icon: 'simple-icons:dart', name: 'Dart' },
  { icon: 'simple-icons:postgresql', name: 'PostgreSQL' },
  { icon: 'simple-icons:tailwindcss', name: 'Tailwind CSS' },
];
---

<Layout title={`Leonardo Omeara | ${t('hero.role')}`}>
  <main class="max-w-5xl mx-auto px-6 pt-32">
    <header class="py-20 grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-8 space-y-6">
        <p class="text-sm font-mono text-blue-400 uppercase tracking-[0.2em]">
          {t('hero.location')}
        </p>
        <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tighter">
          {t('hero.title')}
        </h1>
        <p class="text-xl md:text-2xl font-medium text-white/90">
          {t('hero.role')}
        </p>
        <p class="text-lg text-neutral-400 max-w-2xl">
          {t('hero.subtitle')}
        </p>
      </div>

      <div class="md:col-span-4 flex justify-center md:justify-end">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-2xl border border-white/10 bg-neutral-900 flex items-center justify-center">
          <span class="text-xs font-mono text-neutral-600 uppercase tracking-widest text-center px-4">
            {lang === 'es' ? 'Espacio para foto' : 'Photo placeholder'}
          </span>
        </div>
      </div>
    </header>

    <section id="sobre-mi" class="py-20 border-t border-white/5">
      <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-[0.3em] mb-8 italic">
        {t('about.title')} _
      </h2>
      <p class="text-neutral-300 leading-relaxed text-lg max-w-3xl">
        {t('about.text')}
      </p>
    </section>

    <section id="proyectos" class="py-20 border-t border-white/5">
      <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-[0.3em] mb-12 italic">
        {t('projects.title')} _
      </h2>

      <ProjectCard
        title={t('project.audit.title')}
        description={t('project.audit.desc')}
        tags={t('project.audit.tags').split(',')}
      />

      <ProjectCard
        title={t('project.album.title')}
        description={t('project.album.desc')}
        tags={t('project.album.tags').split(',')}
        link={t('project.album.link')}
      />

      <ProjectCard
        title={t('project.cabrapp.title')}
        description={t('project.cabrapp.desc')}
        tags={t('project.cabrapp.tags').split(',')}
        image={CABRAppInicio}
      />

      <ProjectCard
        title={t('project.portfolio.title')}
        description={t('project.portfolio.desc')}
        tags={t('project.portfolio.tags').split(',')}
        image={esconditeWebInicio}
      />
    </section>

    <section id="habilidades" class="py-24 border-t border-white/5">
      <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-[0.3em] mb-12 italic">
        {t('skills.title')} _
      </h2>

      <div class="space-y-16">
        <div class="space-y-6">
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-widest px-4">{t('skills.strongest')}</h3>
          <div class="grid grid-cols-4 md:grid-cols-8 gap-4">
            {strongestSkills.map((skill) => <Skills icon={skill.icon} name={skill.name} />)}
          </div>
        </div>

        <div class="space-y-6">
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-widest px-4">{t('skills.working')}</h3>
          <div class="grid grid-cols-4 md:grid-cols-8 gap-4">
            {workingSkills.map((skill) => <Skills icon={skill.icon} name={skill.name} />)}
          </div>
        </div>

        <div class="space-y-6">
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-widest px-4">{t('skills.foundational')}</h3>
          <div class="grid grid-cols-4 md:grid-cols-8 gap-4">
            {foundationalSkills.map((skill) => <Skills icon={skill.icon} name={skill.name} />)}
          </div>
        </div>
      </div>
    </section>

    <section id="experiencia" class="py-24 border-t border-white/5">
      <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-[0.3em] mb-12 italic">
        {t('experience.title')} _
      </h2>

      <div class="max-w-3xl">
        <ExperienceItem
          period={t('exp.adres26.period')}
          title={t('exp.adres26.role')}
          company={t('exp.adres26.company')}
          description={t('exp.adres26.desc')}
          stack={t('exp.adres26.stack').split(',')}
        />

        <ExperienceItem
          period={t('exp.adres24.period')}
          title={t('exp.adres24.role')}
          company={t('exp.adres24.company')}
          description={t('exp.adres24.desc')}
          stack={t('exp.adres24.stack').split(',')}
        />

        <ExperienceItem
          period={t('exp.sbd.period')}
          title={t('exp.sbd.role')}
          company={t('exp.sbd.company')}
          description={t('exp.sbd.desc')}
          stack={t('exp.sbd.stack').split(',')}
        />

        <ExperienceItem
          period={t('exp.freelance.period')}
          title={t('exp.freelance.role')}
          company={t('exp.freelance.company')}
          description={t('exp.freelance.desc')}
          stack={t('exp.freelance.stack').split(',')}
        />
      </div>
    </section>

    <section id="contacto" class="py-24 border-t border-white/5">
      <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-[0.3em] mb-8 italic">
        {t('contact.title')} _
      </h2>

      <div class="max-w-2xl">
        <p class="text-neutral-300 text-lg leading-relaxed mb-8">
          {t('contact.text')}
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="https://www.linkedin.com/in/leonardo-omeara/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-500 transition-colors"
          >
            {t('contact.linkedin')}
          </a>
          <a
            href="https://github.com/LeonardoOmeara"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-white border border-white/10 rounded-lg hover:bg-white/5 transition-colors"
          >
            {t('contact.github')}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
