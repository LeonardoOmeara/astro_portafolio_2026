---
interface Props {
  icon: string;
  name: string;
}

const { icon, name } = Astro.props;
---

<div class="group flex flex-col items-center justify-center gap-2 p-4 transition-all duration-300">
  <div class="relative">
    <iconify-icon
      icon={icon}
      class="text-4xl text-neutral-500 group-hover:text-blue-500 group-hover:scale-110 transition-all duration-300 cursor-help"
    ></iconify-icon>
  </div>
  <span class="text-[10px] font-mono uppercase tracking-tighter text-neutral-400 group-hover:text-neutral-200 transition-colors text-center">
    {name}
  </span>
</div>

<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
